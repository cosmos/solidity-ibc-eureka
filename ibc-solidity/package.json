{
  "name": "@cosmos/ibc-contracts",
  "description": "This is a solidity implementation of ibc-eureka.",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "dependencies": {
    "@openzeppelin/contracts": "^5.7.0",
    "@openzeppelin/contracts-upgradeable": "^5.7.0",
    "@uniswap/permit2": "github:Uniswap/permit2#cc56ad0f3439c502c246fc5cfcc3db92bb8b7219"
  },
  "devDependencies": {
    "sp1-contracts": "github:succinctlabs/sp1-contracts#d3629729c3216eb51bd4859d027a8eb729399fa4",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "prettier": "^3.9.8",
    "solhint": "^6.2.4",
    "quicktype": "^26.0.0"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "forge",
    "foundry",
    "smart-contracts",
    "solidity",
    "template"
  ],
  "private": true,
  "scripts": {
    "benchmarks:check": "bun benchmarks/generate.ts check",
    "benchmarks:ci": "bun run lint:benchmarks && bun run test:benchmarks && bun run benchmarks:check",
    "benchmarks:update": "bun benchmarks/generate.ts update",
    "lint:benchmarks": "prettier --check 'benchmarks/*.ts'",
    "lint:sol": "forge fmt --check && bun solhint -w 0 '{scripts,contracts,test}/**/*.sol'",
    "lint:natspec": "bun natspec-smells --include 'contracts/**/*.sol'",
    "test:benchmarks": "bun test benchmarks",
    "test:coverage": "forge coverage",
    "test:coverage:report": "forge coverage --report lcov && genhtml lcov.info --branch-coverage --output-dir coverage"
  }
}
